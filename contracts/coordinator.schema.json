{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PiggiesTransactionCoordinator",
  "description": "Contrato ativo conforme REQUISITOS.md e contracts/README.md. Entrada OfferCreated; sem endpoints HTTP. x-* documentam saídas e não são configuração automática.",
  "$ref": "events/offer-created.schema.json",
  "x-consumedEvents": {
    "OfferCreated": {
      "schema": "events/offer-created.schema.json",
      "topic": "slp.offers.created",
      "key": "PIGGY-USD",
      "group": "slp-coordinator"
    }
  },
  "x-publishedEvents": {
    "TradeExecuted": {
      "schema": "events/trade-executed.schema.json",
      "topic": "slp.trades.executed",
      "key": "tradeId"
    },
    "ExchangeRateUpdated": {
      "schema": "events/exchange-rate-updated.schema.json",
      "topic": "slp.exchange-rate.updated",
      "key": "PIGGY-USD"
    }
  }
}
