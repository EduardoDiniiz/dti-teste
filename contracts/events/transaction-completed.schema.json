{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransactionCompleted",
  "description": "Evento v1. Deduplicar por eventId; retries preservam ID, data e payload. Regras entre campos exigem testes de negócio.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "TransactionCompleted"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transactionId": {
          "type": "string",
          "format": "uuid"
        },
        "buyOfferId": {
          "type": "string",
          "format": "uuid"
        },
        "sellOfferId": {
          "type": "string",
          "format": "uuid"
        },
        "buyerId": {
          "type": "string",
          "format": "uuid"
        },
        "sellerId": {
          "type": "string",
          "format": "uuid"
        },
        "buyPriceUsd": {
          "type": "string",
          "pattern": "^(?!0(?:\\.0{1,2})?$)(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,2})?$",
          "description": "USD positivo; até 12 dígitos inteiros e 2 casas decimais; sem expoente. Converter com BigDecimal."
        },
        "sellPriceUsd": {
          "type": "string",
          "pattern": "^(?!0(?:\\.0{1,2})?$)(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,2})?$",
          "description": "USD positivo; até 12 dígitos inteiros e 2 casas decimais; sem expoente. Converter com BigDecimal."
        },
        "executionPriceUsd": {
          "type": "string",
          "pattern": "^(?!0(?:\\.0{1,3})?$)(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,3})?$",
          "description": "USD positivo; até 12 dígitos inteiros e 3 casas decimais; sem expoente. Converter com BigDecimal."
        },
        "quantity": {
          "const": 1
        }
      },
      "required": [
        "transactionId",
        "buyOfferId",
        "sellOfferId",
        "buyerId",
        "sellerId",
        "buyPriceUsd",
        "sellPriceUsd",
        "executionPriceUsd",
        "quantity"
      ]
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "payload"
  ],
  "examples": [
    {
      "eventId": "44444444-4444-4444-8444-444444444444",
      "eventType": "TransactionCompleted",
      "schemaVersion": 1,
      "occurredAt": "2026-09-28T18:00:00Z",
      "payload": {
        "transactionId": "33333333-3333-4333-8333-333333333333",
        "buyOfferId": "11111111-1111-4111-8111-111111111111",
        "sellOfferId": "22222222-2222-4222-8222-222222222222",
        "buyerId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
        "sellerId": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
        "buyPriceUsd": "30.00",
        "sellPriceUsd": "20.00",
        "executionPriceUsd": "25.000",
        "quantity": 1
      }
    }
  ]
}
