{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slp.exchange-rate.updated",
  "title": "ExchangeRateUpdated",
  "description": "Publicado pelo Coordinator via outbox, tópico slp.exchange-rate.updated, chave PIGGY-USD. Formato alinhado ao record ExchangeRateUpdatedMessage da equipe.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "tradeId",
    "pair",
    "rate",
    "occurredAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "tradeId": {
      "type": "string",
      "format": "uuid"
    },
    "pair": {
      "const": "PIGGY-USD"
    },
    "rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "multipleOf": 0.01,
      "description": "Média com escala 2 e HALF_EVEN, conforme RN03."
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "eventId": "44444444-4444-4444-8444-444444444444",
      "tradeId": "33333333-3333-4333-8333-333333333333",
      "pair": "PIGGY-USD",
      "rate": 25.0,
      "occurredAt": "2026-09-28T18:00:00Z"
    }
  ]
}
